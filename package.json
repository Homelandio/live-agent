{
  "name": "live-agent",
  "version": "0.1.0",
  "description": "Local-first live streaming assistant with protected prompt window",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "npm run test:transcriber && npm run test:audio && npm run test:vault && npm run test:workspace && npm run test:retrieval && npm run audit:public",
    "test:audio": "node scripts/test-audio-segmentation.js",
    "test:vault": "node scripts/test-vault-persistence.js",
    "test:transcriber": "node scripts/test-transcriber-provider.js",
    "test:workspace": "node scripts/test-workspace-tools.js",
    "test:retrieval": "node scripts/test-retrieval.js",
    "audit:public": "node scripts/audit-public.js",
    "create:icon": "node scripts/create-icon.js"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.liveagent.desktop",
    "productName": "直播智答",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "PRODUCT.md",
      "DESIGN.md",
      "AGENT_GUIDE.md",
      "SKILLS.md"
    ],
    "extraResources": [
      {
        "from": "transcriber",
        "to": "transcriber",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "live-agent-icon.ico"
      },
      {
        "from": "node_modules/sherpa-onnx-node",
        "to": "transcriber/node_modules/sherpa-onnx-node"
      },
      {
        "from": "node_modules/sherpa-onnx-win-x64",
        "to": "transcriber/node_modules/sherpa-onnx-win-x64"
      }
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LiveAgent-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "直播智答"
    }
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "sherpa-onnx-node": "^1.13.8"
  }
}
